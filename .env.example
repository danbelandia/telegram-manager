# Telegram
# Token del bot que creas con @BotFather. Nunca commitear este archivo.
TELEGRAM_BOT_TOKEN=
# polling para desarrollo local; webhook para produccion
TELEGRAM_MODE=polling
# Solo en modo webhook: URL publica HTTPS y secret para validar el header
# X-Telegram-Bot-Api-Secret-Token
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=

# PostgreSQL
# En Docker Compose el host es "postgres"; en local sin Docker usa "localhost"
DATABASE_URL=postgres://telegram:telegram@postgres:5432/telegram_manager?sslmode=disable

# Autenticacion del panel (modulo auth, paso 9)
# Secret que firma los JWT. Minimo 32 caracteres. No commitear.
JWT_SECRET=
# Credenciales del admin inicial (se crea solo si la tabla admins esta vacia)
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Cookie de refresh: Secure solo en produccion (https). En dev local
# (http://localhost) debe ser false para que el navegador la envie.
COOKIE_SECURE=false

# Servidor
PORT=8080

# Frontend
# Opcional: solo si el panel se sirve desde una raiz distinta a la API
# (ej. https://panel.example.com en produccion). En desarrollo el proxy
# de Vite (frontend/vite.config.ts) resuelve /api -> backend; dejar vacio.
# VITE_API_BASE_URL=

# Migraciones: aplicadas automaticamente al arrancar en desarrollo
RUN_MIGRATIONS=true